[{"n":1,"title":"Now Is Early","artist":"Nicolette","year":1992,"mbid":null,"heard":false,"cover":"https://data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":null,"genres":[],"rym":"https://rateyourmusic.com/release/album/nicolette/now-is-early","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":2,"title":"Foxbase Alpha","artist":"Saint Etienne","year":1991,"mbid":"726170fb-e4ce-378a-bec4-c74e742920ab","heard":true,"cover":"https://dn710608.ca.archive.org/0/items/mbid-649225ba-8062-310c-b8ba-ff4ac656f4dc/mbid-649225ba-8062-310c-b8ba-ff4ac656f4dc-3523236178.jpg","spotify_id":null,"spotify_url":"https://open.spotify.com/album/7e0mEjhM8D2x8E5c9H1oY3","desc_lfm_album":"Foxbase Alpha remains one of the most dewy-fresh debut albums ever made. Newly relocated from suburban Croydon to Tufnell Park, north London, schoolfriends Bob Stanley and Pete Wiggs set about creating what Stanley has called \"a time capsule of our lives in that year\". Foxbase Alpha (named after a childhood in-joke about a place filled with gorgeous people) is both retro and modern, a love letter and a scrapbook, a compendium of private passions from Dusty Springfield to King Tubby, David Mamet to football, C86 to ambient house, and London, always London. The packaging, with its Jon Savage sleevenotes and .","desc_lfm_artist":"Saint Etienne is an indie dance/indie pop trio which formed in Croydon, England in 1990. The band was founded by journalist Bob Stanley (born December 25, 1964) and Pete Wiggs (born May 15, 1966) in Croydon, UK, January 1990. After recording 2 singles with guest singers, Sarah Cracknell (born April 12, 1967, Chelmsford, Essex) joined as a full member. The band is named after a French football team.\n\nSaint Etienne are one of the bands who defined the early 90s indie dance genre","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"PMfGhQJIaKM","genres":["leftfield","acid house","indie pop","alternative dance","house","indietronica"],"rym":"https://rateyourmusic.com/release/album/saint-etienne/foxbase-alpha/","scaruffi_rating":7.0,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":3,"title":"Look How Long","artist":"Loose Ends","year":1990,"mbid":null,"heard":false,"cover":"https://e.snmc.io/i/600/s/d498be9ebc68de5817c57ace22b71a62/7901641/Loose%20Ends%20-%20Look%20How%20Long%2C%20Cover%20art.jpeg","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":null,"genres":[],"rym":"https://rateyourmusic.com/release/album/loose-ends/look-how-long","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":4,"title":"Road to Freedom","artist":"The Young Disciples","year":1991,"mbid":null,"heard":false,"cover":"https://e.snmc.io/i/600/s/1f84fe948fc1caaab610d2a9cbc8ae05/1366815/The%20Young%20Disciples%20-%20Road%20to%20Freedom%2C%20Cover%20art.jpeg","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":null,"genres":[],"rym":"https://rateyourmusic.com/release/album/the-young-disciples/road-to-freedom","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":5,"title":"Vol II: 1990 - A New Decade","artist":"Soul II Soul","year":1990,"mbid":null,"heard":false,"cover":"https://data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=","spotify_id":null,"spotify_url":null,"des