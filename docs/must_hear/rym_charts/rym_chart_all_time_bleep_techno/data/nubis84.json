smith, Erik Wiegand's project Errorsmith is a pure live performance. The third Errorsmith release contains a selection of live recordings made between 2001 and 2003 in various clubs and concert venues from Berlin to Chicago. Wiegand's performances are interpretations of classic disco and r'n b songs. Digitally synthesized, distorted and filtered clubmusic which goes far beyond its origin.\n\nThe live sets are played on a laptop with a selfbuild digital live tool, a combination of a simple sequencer and a synthesizer.","desc_mb_album":null,"desc_mb_artist":null,"yt_id":"6M3JPJyxxW0","genres":[],"rym":"https://rateyourmusic.com/release/album/errorsmith/superlative-fatigue","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":10,"title":"Void Dweller","artist":"Eon","year":1992,"mbid":null,"heard":false,"cover":"https://data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":null,"genres":[],"rym":"https://rateyourmusic.com/release/album/eon/void-dweller","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":11,"title":"Lapton","artist":"paszka","year":2023,"mbid":null,"heard":false,"cover":"https://data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=","spotify_id":null,"spotify_url":null,"desc_lfm_album":null,"desc_lfm_artist":null,"desc_mb_album":null,"desc_mb_artist":null,"yt_id":null,"genres":[],"rym":"https://rateyourmusic.com/release/album/paszka/lapton","scaruffi_rating":null,"scaruffi_note":null,"wikipedia_url":null,"aoty_user_score":null,"aoty_critic_score":null,"metacritic_score":null,"label":null},{"n":12,"